# Local demo configuration only. Copy to .env and replace the password.
POSTGRES_DB=microtrace
POSTGRES_USER=microtrace
POSTGRES_PASSWORD=replace-with-local-only-password
# The password must match above; URL-encode it when necessary.
DATABASE_URL=postgresql+psycopg://microtrace:replace-with-local-only-password@postgres:5432/microtrace
COLLECTOR_URL=http://trace-backend:8000/api/v1/spans
EXPORT_QUEUE_SIZE=256
EXPORT_TIMEOUT_SECONDS=1
PAYMENT_SERVICE_URL=http://payment-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
